#!/bin/bash

# tmux-sessionizer用のfzfポップアップ版
# 既存のtmux-sessionizerと同じスタイルでポップアップ表示

# tmux-sessionizerのパスを確認
SESSIONIZER_PATH="$HOME/.local/share/tmux-sessionizer/tmux-sessionizer"

if [ ! -f "$SESSIONIZER_PATH" ]; then
    echo "tmux-sessionizer not found at $SESSIONIZER_PATH"
    sleep 1
    exit 1
fi

# tmux-sessionizerの設定を読み込み
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-sessionizer"
CONFIG_FILE="$CONFIG_DIR/tmux-sessionizer.conf"

# デフォルトの検索パス
search_dirs=(
    "$HOME/Repos/github.com/harunosuke-dev"
    "$HOME/Repos/github.com/Harunosuke-web"
    "$HOME/Projects"
    "$HOME/Dev"
)

# 設定ファイルが存在する場合は読み込み
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
    if [ ${#TS_SEARCH_PATHS[@]} -gt 0 ]; then
        search_dirs=("${TS_SEARCH_PATHS[@]}")
    fi
fi

# 存在するディレクトリのみを対象にする
existing_dirs=()
for dir in "${search_dirs[@]}"; do
    expanded_dir="${dir/#\~/$HOME}" # ~を展開
    [ -d "$expanded_dir" ] && existing_dirs+=("$expanded_dir")
done

# そのパス自体を候補に出すディレクトリ。
# TS_SEARCH_PATHS は -mindepth 1 で「子」だけを候補にするため、~/.dotfiles の
# ようにディレクトリ自体を1つのセッションにしたいものはここへ書く。
# 設定ファイルの TS_EXACT_PATHS で指定する（本家 tmux-sessionizer には無い独自の変数）
exact_dirs=()
for dir in "${TS_EXACT_PATHS[@]}"; do
    expanded_dir="${dir/#\~/$HOME}"
    [ -d "$expanded_dir" ] && exact_dirs+=("$expanded_dir")
done

if [ ${#existing_dirs[@]} -eq 0 ] && [ ${#exact_dirs[@]} -eq 0 ]; then
    echo "No search directories found"
    sleep 1
    exit 1
fi

# 候補から外すディレクトリ名。basename に対する glob で、設定ファイルの
# TS_IGNORE_NAMES で上書きできる（本家 tmux-sessionizer には無い独自の変数）
ignore_names=(.git node_modules)
if [ ${#TS_IGNORE_NAMES[@]} -gt 0 ]; then
    ignore_names=("${TS_IGNORE_NAMES[@]}")
fi

# find へ渡す除外条件を組み立てる
prune_args=()
for name in "${ignore_names[@]}"; do
    prune_args+=(! -name "$name")
done

# 指定したパスが TS_EXACT_PATHS に含まれるか
is_exact_dir() {
    local target="$1" e
    for e in "${exact_dirs[@]}"; do
        if [ "$e" = "$target" ]; then
            return 0
        fi
    done
    return 1
}

# ディレクトリからセッション名を作る。
#
#   TS_EXACT_PATHS のもの  basename（親は ~ になるので足しても意味が無い）
#   それ以外                親/子（別リポジトリの同名ディレクトリを区別する）
#
# WARNING: 名前に . を残さない。tmux のターゲット指定では . が
# 「ウィンドウ.ペイン」の区切りになり、含めると has-session も
# switch-client も届かなくなる（一覧には出るのに参照できない）。
# 親にも掛けるのは、検索パスに ~/.dotfiles や ~/.config があるため
session_name_for() {
    local dir="$1" name parent
    # 外部コマンドを呼ばない。候補は40件を超えることがあり、1件あたり
    # basename と dirname と tr で4プロセス起動すると体感で分かるほど遅くなる
    name="${dir##*/}"
    if ! is_exact_dir "$dir"; then
        parent="${dir%/*}"
        name="${parent##*/}/$name"
    fi
    printf '%s' "${name//./_}"
}

# 候補を並べる。順番がそのまま fzf の並びになる。
#   1. TS_SEARCH_PATHS を書いた順に見て、各パスごとに
#        - そのパス自体（TS_EXACT_PATHS にも書いてあれば）を先頭へ
#        - 続けて子ディレクトリを名前順で
#   2. TS_SEARCH_PATHS に無い TS_EXACT_PATHS は最後にまとめる
# awk は重複を消しつつ順番を保つ（sort -u だと並びが崩れる）
list_candidate_dirs() {
    local d e
    # -L: シンボリックリンクを辿るので、リンク先がディレクトリなら候補に含める
    for d in "${existing_dirs[@]}"; do
        if is_exact_dir "$d"; then
            printf '%s\n' "$d"
        fi
        find -L "$d" -mindepth 1 -maxdepth 1 -type d "${prune_args[@]}" 2>/dev/null | sort
    done
    for e in "${exact_dirs[@]}"; do
        local in_search=1
        for d in "${existing_dirs[@]}"; do
            if [ "$e" = "$d" ]; then
                in_search=0
                break
            fi
        done
        if [ "$in_search" -eq 1 ]; then
            printf '%s\n' "$e"
        fi
    done
}

# セッション状態を付けてディレクトリを一覧表示。
#
# 起動中のセッションを先頭へ集め、その中は最後に開いた順に並べる。
# 「戻る先」は行き来の順で決まるので、探すより先に目に入る方が速い。
# これで切り替えもここで済み、専用のキーを別に持たなくてよくなる。
#
# 並べ替えの鍵は「起動中か」と「最後に開いた時刻」の2つ。
# 出力の先頭にタブ区切りで付けて sort に渡し、最後に cut で落とす
format_directories_with_sessions() {
    local green="\033[32m" blue="\033[34m" reset="\033[0m" checked="󰄲" unchecked="󰄱"

    # セッション名 -> 最後に開いた時刻（エポック秒）。開いたことがなければ 0
    local attached
    attached=$(tmux list-sessions -F '#{session_name}	#{session_last_attached}' 2>/dev/null)

    list_candidate_dirs | awk '!seen[$0]++' | while read -r dir; do
        local session_name at line
        session_name=$(session_name_for "$dir")

        # 起動中かどうかを引く。セッションは数個しかないので、
        # 1件ごとに awk を起こすより bash で回す方が速い
        at=''
        local IFS=$'\n'
        for line in $attached; do
            case "$line" in
                "$session_name"$'\t'*)
                    at="${line#*$'\t'}"
                    [ -n "$at" ] || at=0
                    break
                    ;;
            esac
        done
        unset IFS

        # 表示は ~ から。フルパスは端が切れて、どこにいるか読み取りにくい。
        #
        # WARNING: ${dir/#$HOME/~} は使わない。置換先の ~ がホームへ展開される。
        # エスケープした \~ も駄目で、macOS の /bin/bash（3.2）では
        # バックスラッシュがそのまま残る。case で削る方が版に依存しない
        local shown
        case "$dir" in
            "$HOME"/*) shown="~/${dir#"$HOME"/}" ;;
            "$HOME")   shown="~" ;;
            *)         shown="$dir" ;;
        esac

        # 表示・実パス・セッション名をタブで分けて渡す。
        # fzf には先頭だけ見せ、選択後とプレビューは実パスをそのまま使う。
        # 以前はアイコンを sed で剥がしていたが、区切りを持たせる方が確実
        if [ -n "$at" ]; then
            # 起動中。rank=0 で先頭へ、その中は at の大きい順
            printf '0\t%s\t%b%s %s%b\t%s\t%s\n' "$at" "$green" "$checked" "$shown" "$reset" "$dir" "$session_name"
        else
            printf '1\t0\t%b%s %s%b\t%s\t%s\n' "$blue" "$unchecked" "$shown" "$reset" "$dir" "$session_name"
        fi
    done | sort -t$'\t' -k1,1n -k2,2nr -s | cut -f3-
}

# 見た目は呼ばれ方で変える。
# tmux の中では tmux-popup が用意した 90% の popup を目一杯使う。
# tmux の外（zsh のウィジェット）では画面を占有せず、他のウィジェットと揃える
if [ -n "${TMUX-}" ]; then
    fzf_size=(--height=100% --border)
else
    fzf_size=(--height='~60%' --min-height=10 --border=none --info=inline)
fi

# ディレクトリ選択
selected=$(format_directories_with_sessions |
    fzf \
        "${fzf_size[@]}" \
        --layout=reverse \
        --prompt="Create/switch to session: " \
        --header="Select directory for tmux session (󰄲=active 󰄱=new)" \
        --delimiter='\t' \
        --with-nth=1 \
        --preview='
            dir={2}
            session_name={3}
            echo "Directory: $(basename "$dir")"
            echo "Path: $(echo "$dir" | sed "s|^$HOME|~|")"
            if tmux has-session -t "$session_name" 2>/dev/null; then
                echo "Status: 󰄲 Session exists"
            else
                echo "Status: 󰄱 New session"
            fi
            echo ""
            if command -v eza >/dev/null 2>&1; then
                echo "Tree:"
                eza --tree --level=2 --icons --color=always --group-directories-first --ignore-glob=".git|node_modules|.DS_Store|*.log" "$dir" 2>/dev/null || echo "  (empty or access denied)"
            else
                echo "Contents:"
                ls -la --color=always "$dir" 2>/dev/null | head -10 || echo "  (empty or access denied)"
            fi
        ' \
        --preview-window="right:40%" \
        --ansi)

# 2列目に実パスをそのまま入れてあるので取り出すだけでよい
if [ -n "$selected" ]; then
    selected=$(printf '%s' "$selected" | cut -f2)
fi

if [ -z "$selected" ]; then
    exit 0
fi

# セッション名を生成
session_name=$(session_name_for "$selected")

# tmux popup内で実行されているかチェック
if [ -n "$TMUX" ]; then
    # tmux内の場合：セッション切り替え処理
    if tmux has-session -t "$session_name" 2>/dev/null; then
        # 既存セッションに切り替え
        tmux switch-client -t "$session_name"
    else
        # 新しいセッションを作成してから切り替え
        tmux new-session -d -s "$session_name" -c "$selected"
        tmux switch-client -t "$session_name"
    fi
else
    # tmux外の場合：セッションを作成してattach
    #   -A  既存があればattachする
    #   -D  そのセッションに繋いでいる他のクライアントを切り離す
    #
    # -D が無いと、別の端末（例: Alacritty と Ghostty）から同じセッションへ
    # 繋いだ時にサイズの違うクライアントが同居する。window-size = latest では
    # 最後に操作した方へ交互にリサイズが走り、ペインが伸縮して点滅する
    exec tmux new-session -A -D -s "$session_name" -c "$selected"
fi
