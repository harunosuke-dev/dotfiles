""" ----- nvim から読まれた時は何もしない -----
" .zshenv が VIMINIT を全プロセスに export しているため、nvim もこのファイルを
" source してしまう（vim は $XDG_CONFIG_HOME/vim/vimrc を自動では読まないので
" VIMINIT を外せない。--version には 3rd user vimrc file として並ぶが、
" patch-9.1.0327 を持つビルドでも実際には読み込まれなかった）。
"
" 素通しすると下の set viminfo が nvim では ShaDa ファイルの指定として解釈され、
" 中身が Vim 形式なので E576 で書き込みに失敗し、
" ~/.local/state/vim/viminfo.tmp.* が書き捨てられていく（2ヶ月で23個溜まっていた）。
" packadd の 2 行も nvim には無いディレクトリを指すので E919 になる。
"
" alias nvim='VIMINIT= nvim' でも防げるのは対話シェルから打った時だけで、
" $EDITOR / $GIT_EDITOR 経由（git のコミットメッセージ編集など）は素通りする
if has('nvim')
  finish
endif

""" ----- Plugin directory (XDG) -----
" プラグインは ~/.vim ではなく $XDG_DATA_HOME/vim に置く。
" configではなくdata扱いなのと、~/.config/vim はdotfilesリポジトリへの
" symlinkのため、そこにプラグインを置くとリポジトリ内に混入するのを避ける。
set packpath^=$XDG_DATA_HOME/vim
set runtimepath^=$XDG_DATA_HOME/vim

filetype plugin on


""" ----- 同梱パッケージ -----
" Vim 9.1 に同梱されているものを使い、外部プラグインを増やさない。
" どちらも Neovim 側は標準で有効なため、環境をまたいで挙動が揃う。
"
" comment      … gc / gcc でコメントの切り替え（Neovim は 0.10 以降が標準で持つ）
" editorconfig … .editorconfig のインデント設定などを尊重する
packadd comment
packadd! editorconfig


" -----------------------------------------------------------------------------
" Basic Settings
"   Research any of these by running :help <setting>
" -----------------------------------------------------------------------------
let mapleader = " "
let maplocalleader = " "


""" ----- cursor style -----
" Use a line cursor within insert mode and a block cursor everywhere else.
"
" Using iTerm2? Go-to preferences / profile / colors and disable the smart bar
" cursor color. Then pick a cursor and highlight color that matches your theme.
" That will ensure your cursor is always visible within insert mode.
"
" Reference chart of values:
"   Ps = 0  -> blinking block.
"   Ps = 1  -> blinking block (default).
"   Ps = 2  -> steady block.
"   Ps = 3  -> blinking underline.
"   Ps = 4  -> steady underline.
"   Ps = 5  -> blinking bar (xterm).
"   Ps = 6  -> steady bar (xterm).
let &t_ti.= "\e[2 q" " Vim 起動時に非点滅のブロックタイプのカーソル
let &t_SI = "\e[6 q" " 挿入モード時に非点滅の縦棒タイプのカーソル
let &t_EI = "\e[2 q" " ノーマルモード時に非点滅のブロックタイプのカーソル
let &t_SR .= "\e[4 q" " 置換モード時に非点滅の下線タイプのカーソル
let &t_te.="\e[0 q" " vim 終了時にカーソルを mintty のデフォルトに設定


""" ----- cursor line  -----
" Only show the cursor line in the active buffer.
augroup CursorLine
    au!
    au VimEnter,WinEnter,BufWinEnter * setlocal cursorline
    au WinLeave * setlocal nocursorline
augroup END


""" ----- options -----
set nocompatible " Viとの互換性を無効にする

if &t_Co > 2 || has("gui_running")
    syntax enable
    set hlsearch
endif

set fenc=utf-8
set background=dark
set virtualedit=block
set textwidth=0 " 一行に長い文章を書いていても自動折り返しをしない
set display=lastline
set hidden
set autoread
set showcmd
set showmatch
set shellslash
" --- Indentation
set autoindent " 新しい行を作ったときに前の行と同じインデントにする
set smartindent " 行頭の余白内でTabを打ち込むと'shiftwidth'の数だけインデントする
set tabstop=2
set softtabstop=2
set shiftwidth=2
set shiftround
set smarttab
set list
set listchars=tab:▸\
" --- Views
set title
set number
set relativenumber
set ruler
set cursorline
set noshowmode
set laststatus=2
set showtabline=2
set ambiwidth=double
" --- Controls
set mouse=a
" <Esc> をノーマルモードにマップしているため、矢印キーなどが送る
" エスケープシーケンスと区別する必要がある。ttimeout が off だと
" timeoutlen（1秒）待たされて矢印キーが実用にならない。Neovim の既定と揃える
set ttimeout
set ttimeoutlen=50
set whichwrap=b,s,h,l,<,>,[,]
" --- Search
set incsearch
set smartcase
set ignorecase
" --- Split
set splitbelow
set splitright
" --- Backspace
set backspace=indent,eol,start
" --- Menu
" コマンドラインの補完。打った時点で候補のポップアップを出す
" （:help cmdline-autocompletion）。
"
" 候補の操作は Vim 標準のまま使う（:help 'wildmenu'）。上書きしない。
"   Ctrl-n / Ctrl-p   次 / 前の候補へ
"   Up / Down         候補が出ている時は候補の移動、出ていない時は履歴を辿る
"   Ctrl-y            選択中の候補で確定
"   Ctrl-e            候補を捨てて打った文字列に戻す
"
" ヘルプの例には Up / Down を常に履歴へ回す cnoremap が載っているが、
" 候補が出ている時は候補を選びたいので採用しない。
"
" wildtrigger() は Vim 9.1 の途中で入った関数なので、古い Vim では
" 従来どおり <Tab> を押して補完する形に落とす
set wildmenu
if exists('*wildtrigger')
    set wildmode=noselect:lastused,full
    set wildoptions=pum
    autocmd CmdlineChanged [:/\?] call wildtrigger()
else
    set wildmode=list:longest
endif
" --- Completion
set completeopt=menuone,noinsert,noselect
let g:completion_matching_strategy_list = ['exact', 'substring', 'fuzzy']


""" ----- Backup -----
" --- viminfo (default dir=$HOME/.viminfo)
set viminfo+=n~/.local/state/vim/viminfo  | call mkdir($XDG_STATE_HOME . '/vim', 'p')

" --- backup
" backup ファイルは作らない。undofile があれば取り消せるため
set nobackup

" --- swapfile (default: set swapfile)
set noswapfile

" --- undofile (default: set noundofile, default dir=.)
set undodir=$XDG_STATE_HOME/vim/undo      | call mkdir(&undodir,   'p')
set undofile


""" ----- Colorscheme -----
" 24bit 色。端末が対応している時だけ有効にする。
" tmux / screen の中では 24bit 色のエスケープを明示しないと色が化ける
if has('termguicolors') && ($COLORTERM ==# 'truecolor' || $COLORTERM ==# '24bit')
    let &t_8f = "\<Esc>[38;2;%lu;%lu;%lum"
    let &t_8b = "\<Esc>[48;2;%lu;%lu;%lum"
    set termguicolors
endif

" 面を塗らずに端末の背景を透けさせる。
" Vim に透過のオプションは無いので、背景の指定を外して実現する。
"
" 本文（Normal）だけでなく左端の列も対象にする。カラースキームによっては
" それらが独自の色を持ち、本文だけ透過すると左端に帯が残るため。
" 文字色はそのままで背景だけ外せばよい。
"
" ステータスラインは対象にしない。habamax は「暗い文字 + 明るい背景」という
" 作りで（guifg=#1c1c1c guibg=#9e9e9e）、背景を外すと文字が読めなくなるため。
" CursorLine / Pmenu / VertSplit も塗られていることに意味があるので触らない
let s:transparent_groups = [
\   'Normal', 'NonText', 'EndOfBuffer',
\   'LineNr', 'LineNrAbove', 'LineNrBelow', 'SignColumn', 'FoldColumn',
\ ]

function! s:Transparent() abort
    for l:name in s:transparent_groups
        if hlID(l:name) == 0
            continue
        endif
        execute 'highlight' l:name 'ctermbg=NONE guibg=NONE'
    endfor
endfunction

augroup Transparent
    autocmd!
    autocmd ColorScheme * call s:Transparent()
augroup END

" Vim 9 同梱の暗い配色。彩度が低く、コメントも無彩色。
" 外部のカラースキームを持ち込まずに、どの環境でも同じ見た目にする。
" 上の autocmd により、この時点で背景の指定が外れる
colorscheme habamax


""" ----- Keymaps -----
" 割り当ては Neovim 側（別リポジトリの lua/config/keymaps.lua）と揃える。
" 素の Vim の標準を潰すものには、何を失うかを添える。

" 検索ハイライトを消す。ノーマルの <Esc> は本来なにもしない
nnoremap <silent> <Esc> :nohlsearch<CR>

" ウィンドウ間の移動。標準の <C-w>h なども当然そのまま使える
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" ウィンドウ操作は素の Vim の <C-w> に全部揃っているので、そちらを覚えるのが
" 本筋。ただし分割は使用頻度が高いので、押しやすい場所にも置く
nnoremap <leader>ws <C-w>s
nnoremap <leader>wv <C-w>v

" バッファ。Neovim 0.11 は ]b / [b を標準で持つので、Vim 側にも同じものを作る
nnoremap <silent> ]b :bnext<CR>
nnoremap <silent> [b :bprevious<CR>
nnoremap <silent> <leader>bd :bdelete<CR>

" j / k は表示行で動かす。ただし回数を付けた時（5j など）は論理行のままにする。
" 相対行番号が示すのは論理行なので、数字を打った時はそちらに従う方が合う
nnoremap <expr> j v:count ? 'j' : 'gj'
nnoremap <expr> k v:count ? 'k' : 'gk'
xnoremap <expr> j v:count ? 'j' : 'gj'
xnoremap <expr> k v:count ? 'k' : 'gk'
nnoremap <silent> <Down> gj
nnoremap <silent> <Up>   gk
inoremap <silent> <Down> <C-\><C-o>gj
inoremap <silent> <Up>   <C-\><C-o>gk
" 行頭・行末も表示行に合わせる
nnoremap 0 g0
nnoremap $ g$
xnoremap 0 g0
xnoremap $ g$

" 挿入モードの移動・削除を emacs 方式に寄せる。シェル（zsh は bindkey -e）と
" 指の使い方を揃えるため。ノーマルモードの割り当ては一切変えない。
"
" 置き換える標準と、その代わりの手段:
"   i_CTRL-A  直前に挿入したテキストを再挿入   出番が少ない
"   i_CTRL-E  下の行の同じ桁の文字をコピー     出番が少ない（上の行は C-y で残る）
"   i_CTRL-B  現代の Vim では未使用            失うものが無い
"   i_CTRL-F  現在行を再インデント             ノーマルの == で足りる
"   i_CTRL-D  インデントを一段戻す             下の <S-Tab> に同じものを置いてある
"
" 一方ノーマルの <C-a>（数値を増やす）は Vim の看板機能なので標準のまま残す
inoremap <silent> <C-a> <C-o>I
inoremap <silent> <C-e> <End>
inoremap <silent> <C-b> <Left>
inoremap <silent> <C-f> <Right>
inoremap <silent> <C-d> <Del>

" 触らない標準。emacs と意味が違うが、Vim 側の機能を残す価値が上回る
"   i_CTRL-K  ダイグラフ入力（<C-k>ae → æ）。代わりが <C-v>u+コードしかない
"   i_CTRL-N  キーワード補完。emacs の「次の行」より使う
"   i_CTRL-P  同上（前の候補）
"   i_CTRL-R  レジスタの内容を挿入
"   i_CTRL-O  一発だけノーマルモードのコマンドを実行
"   i_CTRL-T  インデントを一段深くする
"   i_CTRL-V  次の1文字をそのまま入れる
"   i_CTRL-Y  上の行の同じ桁の文字をコピー
" なお i_CTRL-H（Backspace）・i_CTRL-W（前の単語を削除）・i_CTRL-U（カーソルより
" 前を削除）は元から emacs と同じ動きなので何もしなくてよい

" 挿入中にインデントを一段戻す。標準の i_CTRL-D と同じ働き
inoremap <silent> <S-Tab> <C-\><C-o><<

" インデント調整後も選択範囲を保持する。
" 標準は選択が解除される。解除したい時は <Esc> を打てばよい
xnoremap < <gv
xnoremap > >gv

" 選択した行をまとめて上下に移動する。
" 潰す標準は J（選択行の連結）と K（keywordprg）。
" 連結は :'<,'>j、展開は Neovim 側の <leader>j（treesj）が担当する
xnoremap J :m '>+1<CR>gv=gv
xnoremap K :m '<-2<CR>gv=gv

" スクロール・検索移動のあとカーソルを画面中央に寄せる
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz
nnoremap n nzzzv
nnoremap N Nzzzv

" yank だけを OS のクリップボードへ送る。
" clipboard=unnamedplus にすると d や x や c まで OS 側を上書きしてしまい、
" コピーしておいた内容が消える。レジスタを明示すれば無名レジスタにも入るので、
" y のあとは p でそのまま貼れる。逆向きに貼るのは "+p
nnoremap y "+y
xnoremap y "+y
nnoremap Y "+y$
xnoremap Y "+Y

" * / g* を「その場に留まる」動きにする。
" 標準の * は検索語を登録したうえで次の出現へ飛ぶため、cgn で置換を始めると
" 1つ目が飛ばされる。keepjumps はジャンプリストを埋めないようにするため
nnoremap <silent> *  <Cmd>keepjumps normal! *N<CR>
nnoremap <silent> g* <Cmd>keepjumps normal! g*N<CR>

augroup MyKeyMaps
    autocmd!
    " </ と打つと、開いたままのタグ名と > を補完する（htmlcomplete）
    autocmd FileType html inoremap <buffer></ </<C-x><C-o>
augroup END


""" ----- Formatting -----
" コミットメッセージで copy & paste などで勝手に改行させない。
" 標準の ftplugin が textwidth=72 と formatoptions+=t を入れるため、72桁を超えると直前の空白が改行に変わる。
" textwidth は目安として残すので、整えたい時は gq が使える。
augroup NoAutoWrap
    autocmd!
    autocmd FileType gitcommit setlocal formatoptions-=t
augroup END


""" ----- IME -----
" 日本語のまま normal モードへ戻ると操作できないため、英字へ自動で切り替える。
" 50ms 待つのは <C-o> 系の割り当て（<C-a> / 矢印 / <S-Tab>）への対策
" これらでも InsertLeave は発火するので、直後に InsertEnter が来たら取り消す
if has('mac') && executable('macism')
    let s:ime_timer = -1

    function! s:ImeAsciiDefer() abort
        let s:ime_timer = timer_start(50, {-> job_start(['macism', 'com.apple.keylayout.ABC'])})
    endfunction

    function! s:ImeAsciiCancel() abort
        if s:ime_timer != -1
            call timer_stop(s:ime_timer)
            let s:ime_timer = -1
        endif
    endfunction

    augroup ImeAscii
        autocmd!
        autocmd InsertLeave * call s:ImeAsciiDefer()
        autocmd InsertEnter * call s:ImeAsciiCancel()
    augroup END
endif


""" ----- Find -----
" fzf が無い環境でも探せるようにしておく。
" path+=** で :find が再帰的にファイル名を補完できるようになる
set path+=**
set wildignore+=*/node_modules/*,*/.git/*,*/dist/*,*/build/*,*/.next/*

" fzf.vim は「fzf 本体に同梱されている Vim プラグイン」に依存する。
" fzf#run() や fzf#wrap() はそちらの plugin/fzf.vim（34KB ほどの1ファイル）が
" 定義しており、PATH に fzf コマンドがあるだけでは足りない。
"
" 置き場所はディストリビューションで違うため、実行ファイルから辿って候補を順に見る。
"   Homebrew  /opt/homebrew/Cellar/fzf/<ver>/plugin/fzf.vim
"   Linux 系   <prefix>/share/fzf/plugin/fzf.vim
"   git 導入   ~/.fzf/plugin/fzf.vim
let s:fzf_rtp = ''
if executable('fzf')
    let s:fzf_home = fnamemodify(resolve(exepath('fzf')), ':h:h')
    for s:dir in [s:fzf_home, s:fzf_home . '/share/fzf', $HOME . '/.fzf']
        if filereadable(s:dir . '/plugin/fzf.vim')
            let s:fzf_rtp = s:dir
            break
        endif
    endfor
endif

" 土台と fzf.vim の両方が揃っている時だけ fzf を使う。
" どちらも Vim からは導入しない（本体は Homebrew / Nix / OS のパッケージ、
" fzf.vim は bin/setup-vim-plugins で明示的に入れる）
if !empty(s:fzf_rtp) && !empty(globpath(&packpath, 'pack/*/start/*fzf.vim'))
    let &runtimepath .= ',' . s:fzf_rtp

    if exists('$TMUX')
        let g:fzf_layout = { 'tmux': '-p80%' }
    else
        let g:fzf_layout = { 'down': '100%' }
    endif

    " Customize fzf colors to match your color scheme.
    let g:fzf_colors =
    \ { 'fg':      ['fg', 'Normal'],
      \ 'bg':      ['bg', 'Normal'],
      \ 'hl':      ['fg', 'Comment'],
      \ 'fg+':     ['fg', 'CursorLine', 'CursorColumn', 'Normal'],
      \ 'bg+':     ['bg', 'CursorLine', 'CursorColumn'],
      \ 'hl+':     ['fg', 'Statement'],
      \ 'info':    ['fg', 'PreProc'],
      \ 'prompt':  ['fg', 'Conditional'],
      \ 'pointer': ['fg', 'Exception'],
      \ 'marker':  ['fg', 'Keyword'],
      \ 'spinner': ['fg', 'Label'],
      \ 'header':  ['fg', 'Comment'] }

    let g:fzf_action = {
      \ 'ctrl-t': 'tab split',
      \ 'ctrl-b': 'split',
      \ 'ctrl-v': 'vsplit',
      \ 'ctrl-y': {lines -> setreg('*', join(lines, "\n"))}}

    " [Buffers] Jump to the existing window if possible
    let g:fzf_buffers_jump = 1

    " 割り当ては Neovim 側（fzf-lua）と揃える。環境をまたいでも指が同じ動きをする
    nnoremap <leader>ff :Files<CR>
    nnoremap <leader>fb :Buffers<CR>
    nnoremap <leader>fr :History<CR>
    nnoremap <leader>f/ :BLines<CR>
    nnoremap <leader>fh :Helptags<CR>
    nnoremap <leader>fk :Maps<CR>
    nnoremap <leader>fc :Colors<CR>
    " kickstart 由来の別名。Neovim 側にも同じものを置いてある
    nnoremap <leader><leader> :Buffers<CR>
    nnoremap <leader>/  :BLines<CR>

    " 全文検索は ripgrep に任せる。無い環境では :vimgrep へ落とす
    if executable('rg')
        nnoremap <leader>fg :Rg<CR>
        nnoremap <leader>fw :Rg <C-r><C-w><CR>
    else
        nnoremap <leader>fg :vimgrep //g **/*<Left><Left><Left><Left><Left><Left>
        nnoremap <leader>fw :vimgrep /<C-r><C-w>/g **/*<CR>
    endif
else
    " 素の Vim だけで代替する。
    " 末尾に空白を残しているものは、続けて語を打って <CR> で実行する。
    " <Left> はカーソルを引数の位置へ戻すため
    nnoremap <leader>ff :find *
    nnoremap <leader>fb :buffer<Space>
    nnoremap <leader>fr :browse oldfiles<CR>
    nnoremap <leader>f/ :vimgrep //g %<Left><Left><Left>
    nnoremap <leader>fh :help<Space>
    nnoremap <leader>fk :map<CR>
    nnoremap <leader>fc :colorscheme<Space>
    nnoremap <leader><leader> :buffer<Space>
    nnoremap <leader>/  :vimgrep //g %<Left><Left><Left>
    nnoremap <leader>fg :vimgrep //g **/*<Left><Left><Left><Left><Left><Left>
    nnoremap <leader>fw :vimgrep /<C-r><C-w>/g **/*<CR>
endif


""" ----- terminal -----
" command! -nargs=* T botright term <args>
