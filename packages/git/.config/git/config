[user]
    name = Harunosuke
    email = harunosuke.dev@gmail.com
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILYiWOVf75qMxjWPAre8KCQfxXtitprxND7NT9hoWcq2

[gpg]
    # program = gpg
    format = ssh

[gpg "ssh"]
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
    allowedSignersFile = ~/.config/git/allowed_signers

[core]
    editor = vim

[init]
    defaultBranch = main

[status]
    showUntrackedFiles = all

[commit]
    verbose = true
    gpgsign = true
    # gpgsign = false # overwritten in conf.d/local.conf
    # template = /Users/papicom/.stCommitMsg

[diff]
    algorithm = histogram

[tag]
    # forceSignAnnotated = false # overwritten in conf.d/local.conf

[merge]
    ff = false
    conflictStyle = diff3

[fetch]
    prune = true

[pull]
     rebase = false

[push]
    # default = simple
    # followTags = true

[advice]
    # addEmptyPathspec = false

[include]
    path = conf.d/alias.conf
    path = conf.d/delta.conf
    path = conf.d/ghq.conf
    # path = conf.d/local.conf

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

