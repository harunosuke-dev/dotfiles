# GitHub 既定 (harunosuke-dev アカウント)
# 1Passwordエージェントに鍵が複数あるため、固定しないと先に提示された別鍵で認証されて push が拒否される。
Host github.com
  User git
  IdentityFile ~/.ssh/harunosuke-dev.pub
  IdentitiesOnly yes

# 旧メインアカウント用（移設完了までの一時エントリ）
# remoteは git@github-web:<アカウント名>/... を使う
Host github-web
  HostName github.com
  User git
  IdentityFile ~/.ssh/harunosuke-web.pub
  IdentitiesOnly yes

# 別アカウント用
# remoteは git@github-alt:<アカウント名>/... を使う
Host github-alt
  HostName github.com
  User git
  IdentityFile ~/.ssh/github-alt.pub
  IdentitiesOnly yes

Host *
  IdentityAgent ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
